#!/usr/bin/env python3
"""omarchy-bezel - choose the Bezel theme of the case panel and edit its parameters.

The QML widget owns no knowledge of themes: everything goes through this script,
which reads the theme folders `bezel` itself reads, edits a theme's `theme.json`
in place (one `.bak` next to it), keeps the case panel on the chosen theme
through the `bezel-run@<theme>` systemd user unit, and caches the previews the
widget shows.

Commands (all print JSON with `--json`, which the widget always passes):

  themes                      every theme, with its state and preview
  status                      the chosen theme plus the themes
  params <theme>              refresh, orientation, elements, every colour
  set <theme> PATH=VALUE...   edit the theme, then restart the unit on it
  use <theme>                 enable --now bezel-run@<theme>, disable the rest
  stop                        disable every bezel-run@ unit
  brightness [PERCENT]        the panel's backlight, read from cache when unset
  thumb <theme>               render and cache one preview
  thumbs                      render every missing or stale preview
  palette                     colour presets from the current Omarchy theme
  devices                     what `bezel devices --json` says
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

MANIFEST = "theme.json"
MANIFEST_BAK = "theme.json.bak"
EXTENSION = "bezeltheme"
THUMB_WIDTH = 96
UNIT_PREFIX = "bezel-run@"
ORIENTATIONS = ("portrait", "reverse-portrait", "landscape", "reverse-landscape")
ORIENTATION_LABELS = {
    "portrait": "vertical",
    "reverse-portrait": "vertical flipped",
    "landscape": "horizontal",
    "reverse-landscape": "horizontal flipped",
}
HEX = re.compile(r"^#[0-9a-fA-F]{3,8}$")
MIN_REFRESH = 0.25
MAX_REFRESH = 10.0


class CliError(Exception):
    """A problem worth one line on stderr and a non-zero exit."""


# --------------------------------------------------------------------- paths --


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def data_home() -> Path:
    """The user's data folder, as bezel resolves it (XDG, else ~/.local/share)."""
    xdg = os.environ.get("XDG_DATA_HOME")
    return Path(xdg) if xdg else home() / ".local" / "share"


def state_dir() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    return (Path(xdg) if xdg else home() / ".cache") / "omarchy-bezel"


def themes_dirs() -> list[Path]:
    """The folders bezel reads themes from, in its order.

    `$BEZEL_THEMES_DIR` wins, then `<bezel>/../share/bezel/themes` (where a
    local install puts them), then `<data home>/bezel/themes`.
    """
    out: list[Path] = []
    override = os.environ.get("BEZEL_THEMES_DIR")
    if override:
        out.append(Path(override))
    binary = shutil_which("bezel")
    if binary:
        out.append(Path(binary).resolve().parent.parent / "share" / "bezel" / "themes")
    out.append(data_home() / "bezel" / "themes")
    unique: list[Path] = []
    for directory in out:
        if directory not in unique:
            unique.append(directory)
    return unique


def shutil_which(name: str) -> str | None:
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def themes_dir() -> Path:
    """The first themes folder that exists, bundled themes' home included."""
    for directory in themes_dirs():
        if directory.is_dir():
            return directory
    return data_home() / "bezel" / "themes"


def theme_names() -> list[str]:
    """Every theme name in every themes folder, sorted, without repeats."""
    names: set[str] = set()
    for directory in themes_dirs():
        if not directory.is_dir():
            continue
        for entry in directory.iterdir():
            if entry.is_dir() and (entry / MANIFEST).is_file():
                names.add(entry.name)
            elif entry.suffix.lower() == f".{EXTENSION}":
                names.add(entry.stem)
    return sorted(names)


def theme_path(name: str) -> Path:
    """The folder or zip of the theme `name`, or a path that does not exist."""
    for directory in themes_dirs():
        folder = directory / name
        if (folder / MANIFEST).is_file():
            return folder
        archive = directory / f"{name}.{EXTENSION}"
        if archive.is_file():
            return archive
    return themes_dir() / name


def thumb_path(name: str) -> Path:
    return state_dir() / "thumbs" / f"{name}.png"


def state_path() -> Path:
    return state_dir() / "state.json"


def read_state() -> dict:
    try:
        return json.loads(state_path().read_text())
    except (OSError, ValueError):
        return {}


def write_state(patch: dict) -> None:
    state = read_state()
    state.update(patch)
    state_path().parent.mkdir(parents=True, exist_ok=True)
    state_path().write_text(json.dumps(state, indent=2) + "\n")


# ------------------------------------------------------------------- themes --


def load_theme(name: str) -> tuple[Path, dict]:
    """The theme `name` as parsed JSON. Zips are read-only and refused here."""
    path = theme_path(name)
    if path.is_dir():
        manifest = path / MANIFEST
    elif path.is_file():
        raise CliError(f"{name}: a .{EXTENSION} archive is read-only here; unpack it to edit")
    else:
        raise CliError(f"no theme at {name}; themes: {', '.join(theme_names()) or 'none'}")
    try:
        return path, json.loads(manifest.read_text())
    except (OSError, ValueError) as error:
        raise CliError(f"cannot read {manifest}: {error}") from error


def save_theme(path: Path, theme: dict) -> None:
    """Write the theme back, keeping the first copy of the file as a backup."""
    manifest = path / MANIFEST
    if not (path / MANIFEST_BAK).exists():
        (path / MANIFEST_BAK).write_bytes(manifest.read_bytes())
    manifest.write_text(json.dumps(theme, indent=2, ensure_ascii=False) + "\n")


def walk(node, prefix: str = ""):
    """Every (dotted path, value) pair in `node`, depth first."""
    if isinstance(node, dict):
        for key, value in node.items():
            yield from walk(value, f"{prefix}.{key}" if prefix else key)
    elif isinstance(node, list):
        for index, value in enumerate(node):
            yield from walk(value, f"{prefix}.{index}" if prefix else str(index))
    else:
        yield prefix, node


def colors_in(theme: dict) -> list[dict]:
    """Every colour in the theme, with the path that addresses it."""
    found = []
    for path, value in walk(theme):
        if isinstance(value, str) and HEX.match(value):
            found.append({"path": path, "value": value})
    return found


def element_entries(theme: dict) -> list[dict]:
    """One entry per element: what the widget needs to list and edit it."""
    entries = []
    for index, element in enumerate(theme.get("elements", [])):
        kind = element.get("kind", {})
        style = kind.get("style", {}) if isinstance(kind.get("style"), dict) else {}
        entries.append(
            {
                "index": index,
                "id": element.get("id"),
                "name": element.get("name", f"element {index}"),
                "type": kind.get("type", "unknown"),
                "visible": element.get("visible", True),
                "opacity": element.get("opacity", 1.0),
                "size": style.get("size"),
                "colors": [
                    color
                    for color in colors_in({"kind": kind})
                    if color["path"].startswith("kind.")
                ],
                "paths": {"visible": f"elements.{index}.visible",
                          "opacity": f"elements.{index}.opacity",
                          "size": f"elements.{index}.kind.style.size"},
            }
        )
    return entries


def backdrop_info(theme: dict) -> dict:
    """What the eye sees behind everything, and the colours that paint it.

    Most themes carry a full-canvas element ("Backdrop") above the theme's own
    background colour, so the colour the theme declares is often invisible:
    painting it changes nothing on the screen. The bottom-most element that
    covers the whole canvas decides. Only when no element does is the theme's
    own background the thing to paint.
    """
    canvas = theme.get("canvas") or {}
    width = float(canvas.get("width", 0) or 0)
    height = float(canvas.get("height", 0) or 0)
    for index, element in enumerate(theme.get("elements", [])):
        if element.get("visible", True) is False:
            continue
        frame = element.get("frame") or {}
        covers = (
            float(frame.get("x", 0) or 0) <= 1.0
            and float(frame.get("y", 0) or 0) <= 1.0
            and float(frame.get("width", 0) or 0) >= width - 1.0
            and float(frame.get("height", 0) or 0) >= height - 1.0
        )
        if not covers:
            continue
        colors = [
            color
            for color in colors_in({"kind": element.get("kind")})
            if color["path"].startswith("kind.")
        ]
        if not colors:
            # A picture or a video covers everything: there is no colour to paint.
            return {"source": "picture", "label": element.get("name", "Backdrop"),
                    "elementIndex": index, "colors": []}
        return {
            "source": "element",
            "label": element.get("name", f"element {index}"),
            "elementIndex": index,
            "colors": [
                {"path": f"elements.{index}.{color['path']}", "value": color["value"]}
                for color in colors
            ],
        }
    background = theme.get("background") or {}
    colors = [
        color
        for color in colors_in({"background": background})
        if color["path"].startswith("background.")
    ]
    if colors:
        return {"source": "color", "label": "Background",
                "elementIndex": None, "colors": colors}
    return {"source": "none", "label": "Backdrop", "elementIndex": None, "colors": []}


def read_params(name: str) -> dict:
    path, theme = load_theme(name)
    background = theme.get("background") or {}
    return {
        "theme": name,
        "path": str(path),
        "refreshSeconds": theme.get("refreshSeconds", 1.0),
        "orientation": theme.get("orientation", "portrait"),
        "orientationLabel": ORIENTATION_LABELS.get(
            theme.get("orientation", "portrait"), theme.get("orientation", "")
        ),
        "backgroundType": background.get("type", "color"),
        "backdrop": backdrop_info(theme),
        "elements": element_entries(theme),
    }


def set_path(theme: dict, path: str, raw: str) -> tuple[str, object]:
    """Write `raw` at the dotted `path` of `theme`, as JSON when it parses.

    A value that is not JSON stays a string, which is what a colour
    (`#rrggbbaa`) is: the field may be a plain string, or a stop inside a
    gradient's list.
    """
    keys = path.split(".")
    node = theme
    for key in keys[:-1]:
        try:
            if isinstance(node, list):
                node = node[int(key)]
            elif isinstance(node, dict):
                node = node[key]
            else:
                raise CliError(f"no such field: {path}")
        except (IndexError, KeyError, ValueError):
            raise CliError(f"no such field: {path}") from None
    last = keys[-1]
    try:
        value = json.loads(raw)
    except ValueError:
        value = raw
    if isinstance(node, list):
        try:
            index = int(last)
            if index >= len(node):
                raise CliError(f"no such field: {path}")
            node[index] = value
        except ValueError:
            raise CliError(f"no such field: {path}") from None
    elif isinstance(node, dict):
        if last not in node:
            raise CliError(f"no such field: {path}")
        node[last] = value
    else:
        raise CliError(f"no such field: {path}")
    return path, value


def set_refresh(theme: dict, raw: str) -> tuple[str, object]:
    try:
        seconds = float(raw)
    except ValueError as error:
        raise CliError(f"refreshSeconds: not a number: {raw}") from error
    seconds = max(MIN_REFRESH, min(MAX_REFRESH, seconds))
    theme["refreshSeconds"] = round(seconds, 2)
    return "refreshSeconds", theme["refreshSeconds"]


def set_orientation(theme: dict, raw: str) -> tuple[str, object]:
    if raw not in ORIENTATIONS:
        raise CliError(f"orientation: one of {', '.join(ORIENTATIONS)}")
    theme["orientation"] = raw
    return "orientation", raw


# ------------------------------------------------------------------ systemd --


def systemctl(*args: str, timeout: float = 10.0) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["systemctl", "--user", *args],
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def service_units() -> set[str]:
    """Every user unit systemd knows by name, read once per run."""
    global _SERVICE_UNITS
    if _SERVICE_UNITS is None:
        result = systemctl("list-unit-files", "--type=service", "--no-legend", "--plain")
        _SERVICE_UNITS = {
            line.split()[0]
            for line in (result.stdout or "").splitlines()
            if line.split()
        }
    return _SERVICE_UNITS


_SERVICE_UNITS: set[str] | None = None
_DEVICES: list | None = None


def device_json():
    """What `bezel devices --json` says, read once per run."""
    global _DEVICES
    if _DEVICES is None:
        binary = shutil_which("bezel")
        if not binary:
            _DEVICES = []
        else:
            result = subprocess.run(
                [binary, "devices", "--json"], capture_output=True, text=True, timeout=30
            )
            try:
                _DEVICES = json.loads(result.stdout)
            except ValueError:
                _DEVICES = []
    return _DEVICES


def screen_info() -> dict | None:
    """The screen the themes are made for: its model and its size."""
    for device in device_json():
        models = device.get("models") or []
        if not models:
            continue
        model = models[0]
        return {
            "id": model.get("id"),
            "name": model.get("name"),
            "width": int(model.get("width", 0)),
            "height": int(model.get("height", 0)),
            "state": device.get("state"),
        }
    return None


# A theme may bring its own launcher: a user unit named after the theme that
# runs something else than `bezel run` — a stream of H.264 frames, a script, a
# generator. The unit must mention bezel or the theme folder, so a service that
# merely shares the theme's name is left alone.
def launcher_unit(name: str) -> str | None:
    unit = f"{name}.service"
    if unit not in service_units():
        return None
    result = systemctl("show", "-p", "ExecStart", "--value", unit)
    text = (result.stdout or "").lower()
    if "bezel" in text or name.lower() in text:
        return unit
    return None


def launcher_for(name: str) -> str:
    """The unit that puts a theme on the screen: its own, or bezel-run@<theme>."""
    return launcher_unit(name) or f"{UNIT_PREFIX}{name}.service"


def launcher_states() -> list[tuple[str, str, str]]:
    """Every launcher this plugin may own: (theme, unit, state)."""
    found = []
    for name in theme_names():
        unit = launcher_for(name)
        found.append((name, unit, unit_state_of(unit)))
    return found


def unit_state_of(unit: str) -> str:
    """active, inactive, masked or absent for a unit this plugin may own."""
    result = systemctl("show", "-p", "ActiveState", "-p", "UnitFileState", unit)
    if result.returncode != 0:
        return "absent"
    fields = dict(
        line.split("=", 1) for line in result.stdout.splitlines() if "=" in line
    )
    if fields.get("UnitFileState") == "masked":
        return "masked"
    if fields.get("ActiveState") in ("active", "activating"):
        return "active"
    return "inactive"


def enabled_themes() -> list[str]:
    """Themes whose unit is enabled, read from the wants symlinks."""
    found: set[str] = set()
    user_units = Path(os.environ.get("XDG_CONFIG_HOME") or home() / ".config") / "systemd" / "user"
    for wants in user_units.glob("*.wants"):
        for link in wants.glob(f"{UNIT_PREFIX}*.service"):
            found.add(link.name[len(UNIT_PREFIX):-len(".service")])
    for entry in user_units.glob(f"{UNIT_PREFIX}*.service"):
        # A symlink to /dev/null is a mask, not a choice of theme.
        if entry.is_symlink() and entry.resolve() != Path("/dev/null"):
            found.add(entry.name[len(UNIT_PREFIX):-len(".service")])
    return sorted(found)


def current_theme() -> str | None:
    """The theme the panel is on: a running launcher, else the enabled one, else ours."""
    names = theme_names()
    for name in names:
        if unit_state_of(launcher_for(name)) == "active":
            return name
    enabled = [name for name in enabled_themes() if name in names]
    if enabled:
        return enabled[0]
    remembered = read_state().get("theme")
    if remembered in names:
        return remembered
    # With no launcher and no memory, the theme touched last is the best guess:
    # that is the one the studio or a terminal was working on.
    if names:
        return max(names, key=lambda name: theme_manifest(name).stat().st_mtime)
    return None


def theme_manifest(name: str) -> Path:
    """The file whose timestamp says when a theme was last changed."""
    path = theme_path(name)
    return path / MANIFEST if path.is_dir() else path


def theme_canvas(name: str) -> tuple[int, int] | None:
    """The size a theme was drawn for, in the units the screen reports."""
    if theme_path(name).is_file():
        return None
    try:
        canvas = json.loads(theme_manifest(name).read_text()).get("canvas") or {}
        return int(canvas["width"]), int(canvas["height"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def fitted_canvas(canvas: tuple[int, int] | None, screen: dict | None) -> bool:
    """Whether a theme is drawn the way this screen stands.

    The panel reports its size the way it is mounted (480x1920 here, upright),
    so a theme of that size *the other way round* is one for a screen lying
    down: it would come out sideways.
    """
    if canvas is None or screen is None:
        return True
    return canvas == (screen["width"], screen["height"])


def rotated_canvas(canvas: tuple[int, int] | None, screen: dict | None) -> bool:
    """The screen's size turned by a quarter: right size, wrong way up."""
    if canvas is None or screen is None:
        return False
    return canvas == (screen["height"], screen["width"])


def use_theme(name: str) -> dict:
    """Hand the panel to `name` through its own launcher, stopping the others."""
    if name not in theme_names():
        raise CliError(f"no theme at {name}")
    target = launcher_for(name)
    for other, unit, state in launcher_states():
        if unit == target or state == "absent":
            continue
        if state != "inactive":
            systemctl("disable", "--now", unit)
    if unit_state_of(target) == "masked":
        systemctl("unmask", target)
    result = systemctl("enable", "--now", target)
    if result.returncode != 0:
        raise CliError(f"cannot start the theme {name}: {(result.stderr or '').strip()}")
    write_state({"theme": name})
    return {"theme": name, "unit": target, "state": unit_state_of(target)}


def stop_theme() -> dict:
    """Take the panel off the screen: stop every launcher of every theme."""
    stopped = []
    for name, unit, state in launcher_states():
        if state in ("active", "inactive"):
            systemctl("disable", "--now", unit)
            stopped.append(name)
    return {"stopped": stopped}


def restart_if_live(name: str) -> bool:
    """Restart the theme's launcher when it is running, so edits show up."""
    unit = launcher_for(name)
    if unit_state_of(unit) != "active":
        return False
    systemctl("try-restart", unit)
    return True


# ------------------------------------------------------------------- thumbs --


def render_theme(name: str, *, force: bool = False) -> dict:
    """Render `name` with demo values into the preview cache, if it is stale."""
    out = thumb_path(name)
    manifest = theme_manifest(name)
    if (
        not force
        and out.is_file()
        and out.stat().st_mtime >= manifest.stat().st_mtime
    ):
        return {"theme": name, "path": str(out), "ok": True,
                "mtime": out.stat().st_mtime, "cached": True}
    binary = shutil_which("bezel")
    if not binary:
        return {"theme": name, "ok": False, "error": "bezel is not on the PATH"}
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as scratch:
        full = Path(scratch) / "render.png"
        result = subprocess.run(
            [binary, "--fake", "render", name, "-o", str(full)],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode != 0 or not full.is_file():
            return {
                "theme": name,
                "ok": False,
                "error": (result.stderr or result.stdout or "render failed").strip(),
            }
        scaled = scale(full, out)
    if not scaled:
        return {"theme": name, "ok": False, "error": "cannot write the preview"}
    return {"theme": name, "path": str(out), "ok": True,
            "mtime": out.stat().st_mtime}


def scale(source: Path, out: Path) -> bool:
    """Shrink a preview to THUMB_WIDTH, through ImageMagick, ffmpeg or not at all."""
    magick = shutil_which("magick") or shutil_which("convert")
    if magick:
        result = subprocess.run(
            [magick, str(source), "-strip", "-resize", f"{THUMB_WIDTH}x", str(out)],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode == 0:
            return True
    ffmpeg = shutil_which("ffmpeg")
    if ffmpeg:
        result = subprocess.run(
            [ffmpeg, "-y", "-loglevel", "error", "-i", str(source),
             "-vf", f"scale={THUMB_WIDTH}:-1", str(out)],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode == 0:
            return True
    # Without a scaler, the widget still gets a preview: it decodes the full one.
    try:
        out.write_bytes(source.read_bytes())
        return True
    except OSError:
        return False


def all_thumbs(force: bool) -> None:
    """Render every stale preview, one JSON line per theme as it lands."""
    names = [row["name"] for row in theme_rows()]
    with ThreadPoolExecutor(max_workers=4) as pool:
        for result in pool.map(lambda name: render_theme(name, force=force), names):
            print(json.dumps(result), flush=True)


# ------------------------------------------------------------------ palettes --


def palette() -> list[dict]:
    """Colour presets: the current Omarchy theme's palette, else the theme colours."""
    path = Path(
        os.environ.get("XDG_STATE_HOME") or home() / ".local" / "state"
    ) / "omarchy" / "current" / "theme" / "colors.toml"
    presets: list[dict] = []
    try:
        text = path.read_text()
    except OSError:
        return presets
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip().strip('"')
        if HEX.match(value):
            presets.append({"name": key.strip(), "value": normalize_hex(value)})
    return presets


def normalize_hex(value: str) -> str:
    """A colour the theme format writes: #rrggbbaa."""
    hexed = value.lstrip("#")
    if len(hexed) == 3:
        hexed = "".join(character * 2 for character in hexed)
    if len(hexed) == 6:
        hexed += "ff"
    return "#" + hexed.lower()


# ------------------------------------------------------------------- verbs --


def theme_rows(*, all_themes: bool = False) -> list[dict]:
    """Every theme this screen can show, with its size, launcher and state."""
    current = current_theme()
    screen = screen_info()
    rows = []
    for name in theme_names():
        path = theme_path(name)
        thumb = thumb_path(name)
        if not (path / MANIFEST).is_file():
            background = "archive"
        else:
            try:
                background = (json.loads((path / MANIFEST).read_text())
                              .get("background") or {}).get("type", "color")
            except (OSError, ValueError):
                background = "unknown"
        canvas = theme_canvas(name)
        fits = fitted_canvas(canvas, screen)
        # A theme for a screen lying down is no use standing up, but the theme
        # that is on the panel right now is listed whatever its size.
        if not fits and not all_themes and name != current:
            continue
        unit = launcher_for(name)
        rows.append(
            {
                "name": name,
                "path": str(path),
                "current": name == current,
                "state": unit_state_of(unit),
                "unit": unit,
                "ownUnit": launcher_unit(name) is not None,
                "background": background,
                "canvas": f"{canvas[0]}\u00d7{canvas[1]}" if canvas else "",
                "fits": fits,
                "rotated": rotated_canvas(canvas, screen),
                "thumb": str(thumb),
                "thumbMtime": thumb.stat().st_mtime if thumb.is_file() else 0,
            }
        )
    return rows


def hidden_counts(screen: dict | None) -> dict:
    """What the list leaves out: themes for other sizes, and turned ones."""
    other = rotated = 0
    for name in theme_names():
        canvas = theme_canvas(name)
        if rotated_canvas(canvas, screen):
            rotated += 1
        elif not fitted_canvas(canvas, screen):
            other += 1
    return {"other": other, "rotated": rotated}


def status(*, with_devices: bool = False) -> dict:
    current = current_theme()
    state = read_state()
    screen = screen_info()
    payload = {
        "theme": current,
        "state": unit_state_of(launcher_for(current)) if current else "absent",
        "unit": launcher_for(current) if current else "",
        "ownUnit": launcher_unit(current) is not None if current else False,
        "brightness": state.get("brightness", 67),
        "themesDir": str(themes_dir()),
        "screen": screen,
        "hidden": hidden_counts(screen),
        "themes": theme_rows(),
    }
    if with_devices:
        payload["devices"] = device_json()
    return payload


def brightness(percent: int | None) -> dict:
    if percent is None:
        return {"brightness": read_state().get("brightness", 67)}
    percent = max(0, min(100, int(percent)))
    binary = shutil_which("bezel")
    if not binary:
        raise CliError("bezel is not on the PATH")
    result = subprocess.run(
        [binary, "brightness", str(percent)], capture_output=True, text=True, timeout=30
    )
    if result.returncode != 0:
        raise CliError((result.stderr or "bezel brightness failed").strip())
    write_state({"brightness": percent})
    return {"brightness": percent}


def apply_changes(name: str, specs: list[str], restart: bool) -> dict:
    """Edit the theme at `name`, then put it back on the screen when it is live."""
    path, theme = load_theme(name)
    edits: list[tuple[str, object]] = []
    backlight: int | None = None
    for spec in specs:
        key, separator, raw = spec.partition("=")
        if not separator:
            raise CliError(f"not a setting: {spec}")
        if key == "refresh":
            edits.append(set_refresh(theme, raw))
        elif key == "orientation":
            edits.append(set_orientation(theme, raw))
        elif key == "brightness":
            backlight = max(0, min(100, int(float(raw))))
        else:
            edits.append(set_path(theme, key, raw))
    if edits:
        save_theme(path, theme)
    changed = list(edits)
    if backlight is not None:
        brightness(backlight)
        changed.append(("brightness", backlight))
    # Only a theme edit needs the screen restarted and the preview redrawn.
    restarted = restart_if_live(name) if (edits and restart) else False
    thumb = render_theme(name, force=True) if edits else None
    return {
        "theme": name,
        "changed": [{"path": key, "value": value} for key, value in changed],
        "restarted": restarted,
        "thumb": thumb,
    }


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="omarchy-bezel", description=__doc__)
    parser.add_argument("--json", action="store_true", help="print JSON (default)")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("themes").add_argument("--all", action="store_true")
    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--devices", action="store_true")

    params_parser = subparsers.add_parser("params")
    params_parser.add_argument("theme")

    set_parser = subparsers.add_parser("set")
    set_parser.add_argument("theme")
    set_parser.add_argument("specs", nargs="+")
    set_parser.add_argument("--no-restart", action="store_true")

    use_parser = subparsers.add_parser("use")
    use_parser.add_argument("theme")

    subparsers.add_parser("stop")

    brightness_parser = subparsers.add_parser("brightness")
    brightness_parser.add_argument("percent", nargs="?")

    thumb_parser = subparsers.add_parser("thumb")
    thumb_parser.add_argument("theme")
    thumb_parser.add_argument("--force", action="store_true")

    thumbs_parser = subparsers.add_parser("thumbs")
    thumbs_parser.add_argument("--force", action="store_true")

    subparsers.add_parser("palette")
    subparsers.add_parser("devices")

    args = parser.parse_args(argv)
    try:
        if args.command == "themes":
            print(json.dumps(theme_rows(all_themes=args.all), indent=2))
        elif args.command == "status":
            print(json.dumps(status(with_devices=args.devices), indent=2))
        elif args.command == "params":
            print(json.dumps(read_params(args.theme), indent=2))
        elif args.command == "set":
            print(json.dumps(
                apply_changes(args.theme, args.specs, not args.no_restart), indent=2))
        elif args.command == "use":
            print(json.dumps(use_theme(args.theme), indent=2))
        elif args.command == "stop":
            print(json.dumps(stop_theme(), indent=2))
        elif args.command == "brightness":
            print(json.dumps(brightness(args.percent), indent=2))
        elif args.command == "thumb":
            print(json.dumps(render_theme(args.theme, force=args.force), indent=2))
        elif args.command == "thumbs":
            all_thumbs(args.force)
        elif args.command == "palette":
            print(json.dumps(palette(), indent=2))
        elif args.command == "devices":
            print(json.dumps(device_json(), indent=2))
    except CliError as error:
        print(f"omarchy-bezel: {error}", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("omarchy-bezel: the screen did not answer in time", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
